@model List<HabitTracker.Model.HabitViewModel>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Habits</h2>

        <div>
            <a asp-action="Create" class="btn btn-outline-info me-2">
                <i class="bi bi-plus-lg"></i>
            </a>

            <!-- Sort Dropdown -->
            <div class="btn-group">
                <button class="btn btn-outline-info dropdown-toggle" data-bs-toggle="dropdown">
                    Sort
                </button>
                <ul class="dropdown-menu dropdown-menu-dark">
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sort="none">Default</a></li>
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sort="name">Name</a></li>
                    <li><a class="dropdown-item" asp-action="Index" asp-route-sort="today">Today Completed</a></li>
                </ul>
            </div>
        </div>
    </div>


    <!-- TABLE (DRAGGABLE) -->
    <table id="habitTable" class="table table-dark table-borderless align-middle">
        <thead class="border-bottom border-secondary">
            <tr>
                <th style="width:40px;"></th>
                <th>Habit</th>
                <th class="text-center">Wed</th>
                <th class="text-center">Tue</th>
                <th class="text-center">Mon</th>
            </tr>
        </thead>

        <tbody id="habitBody">

            @foreach (var h in Model)
            {
                <tr data-id="@h.Id" draggable="true" class="border-bottom border-secondary">

                    <!-- Drag icon -->
                    <td class="text-center cursor-grab">
                        <i class="bi bi-list fs-4 text-secondary drag-handle"></i>
                    </td>

                    <!-- Habit Title -->
                    <td class="py-3">
                        <a asp-action="Details" asp-route-id="@h.Id"
                           class="text-info text-decoration-none fw-semibold">
                            @h.Title
                        </a>
                    </td>

                    <!-- Wed -->
                    <td class="text-center">
                        <button class="toggle-btn bg-transparent border-0"
                                data-id="@h.Id"
                                data-date="@DateTime.Today.AddDays(-2).ToString("yyyy-MM-dd")">

                            <i class="@(h.TwoDaysAgoCompleted ? "bi bi-check-lg text-info" : "bi bi-x-lg text-secondary") fs-4"></i>
                        </button>
                    </td>

                    <!-- Tue -->
                    <td class="text-center">
                        <button class="toggle-btn bg-transparent border-0"
                                data-id="@h.Id"
                                data-date="@DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd")">

                            <i class="@(h.YesterdayCompleted ? "bi bi-check-lg text-info" : "bi bi-x-lg text-secondary") fs-4"></i>
                        </button>
                    </td>

                    <!-- Mon -->
                    <td class="text-center">
                        <button class="toggle-btn bg-transparent border-0"
                                data-id="@h.Id"
                                data-date="@DateTime.Today.ToString("yyyy-MM-dd")">

                            <i class="@(h.TodayCompleted ? "bi bi-check-lg text-info" : "bi bi-x-lg text-secondary") fs-4"></i>
                        </button>
                    </td>

                </tr>
            }
        </tbody>
    </table>

</div>

@section Scripts {
    <script>
        document.querySelectorAll(".toggle-btn").forEach(btn => {
            btn.addEventListener("click", async function (e) {

                e.stopPropagation();

                const id = this.dataset.id;
                const date = this.dataset.date;
                const icon = this.querySelector("i");

                const response = await fetch("/Habit/Toggle", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `id=${id}&date=${date}`
                });

                const data = await response.json();
                if (data.success) {
                    // Swap icon instantly
                    if (icon.classList.contains("bi-x-lg")) {
                        icon.classList.remove("bi-x-lg", "text-secondary");
                        icon.classList.add("bi-check-lg", "text-info");
                    }
                    else {
                        icon.classList.remove("bi-check-lg", "text-info");
                        icon.classList.add("bi-x-lg", "text-secondary");
                    }
                }
            });
        });


        const tbody = document.getElementById("habitBody");

        let dragged;

        tbody.addEventListener("dragstart", e => {
            dragged = e.target;
            e.target.style.opacity = ".5";
        });

        tbody.addEventListener("dragend", e => {
            e.target.style.opacity = "";
        });

        tbody.addEventListener("dragover", e => {
            e.preventDefault();
            const target = e.target.closest("tr");
            if (target && target !== dragged) {
                const rect = target.getBoundingClientRect();
                const mid = rect.top + rect.height / 2;

                if (e.clientY < mid) {
                    tbody.insertBefore(dragged, target);
                } else {
                    tbody.insertBefore(dragged, target.nextSibling);
                }
            }
        });

        tbody.addEventListener("drop", () => {
            saveOrder();
        });

        async function saveOrder() {
            const orderedIds = [...document.querySelectorAll("#habitBody tr")]
                .map(row => row.dataset.id);

            await fetch("/Habit/Reorder", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(orderedIds)
            });
        }
    </script>
}
